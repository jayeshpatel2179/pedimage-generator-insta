TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Go Live (Instagram publishing via upload-post.com) - required for the
# "Go Live" button to work; the rest of the bot runs fine without them.
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=

# Website posting (pedtalkssports.com) - required for the "Add Website Summary" /
# "Go Live Website" flow to work; the rest of the bot (including Instagram Go
# Live) runs fine without it.
WEBSITE_UPLOAD_API_KEY=
# Optional override - defaults to https://www.pedtalkssports.com/api/instagram/upload
WEBSITE_UPLOAD_URL=

# Optional: comma-separated Telegram user IDs allowed to tap "Go Live" /
# "Add Website Summary" / "Go Live Website"
# (e.g. 111111111,222222222). Leave empty to allow anyone in the group.
GO_LIVE_ALLOWED_USER_IDS=
