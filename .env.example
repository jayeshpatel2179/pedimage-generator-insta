TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Instagram publishing via upload-post.com - required for the Instagram half
# of the "Go Live" button; the rest of the bot (image generation, caption
# review, website posting) runs fine without them.
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=

# Website posting (pedtalkssports.com) - required for the website half of the
# "Go Live" button; the rest of the bot (including the Instagram half) runs
# fine without it.
WEBSITE_UPLOAD_API_KEY=
# Optional override - defaults to https://www.pedtalkssports.com/api/instagram/upload
WEBSITE_UPLOAD_URL=

# Optional: comma-separated Telegram user IDs allowed to publish (tap "Go Live",
# "Regenerate Summary", "Edit Instagram caption", "Cancel")
# (e.g. 111111111,222222222). Leave empty to allow anyone in the group.
GO_LIVE_ALLOWED_USER_IDS=

# Optional: 1 = log the exact Instagram/website payloads instead of posting
# (for testing). Leave unset/0 in production.
DRY_RUN=
